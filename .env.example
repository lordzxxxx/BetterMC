# BetterMC Environment Configuration

# Resend Mailer API (for /participate correction submissions)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Organization recipient email for public submissions
CONTACT_EMAIL="bettermc.org@gmail.com"

# Verified sender email address
# Note: Use onboarding@resend.dev until your custom domain (bettermalaybalay.cloud) is verified in Resend DNS.
RESEND_FROM="BetterMC Desk <onboarding@resend.dev>"

# Cloudflare Turnstile bot protection (optional)
# Public site key (browser-visible)
VITE_TURNSTILE_SITE_KEY=""
# Secret key (Cloudflare Pages backend environment variable)
TURNSTILE_SECRET_KEY=""
